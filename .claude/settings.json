{
  "enabledPlugins": {
    "harness@ai-kit": true,
    "flutter@ai-kit": true
  },
  "permissions": {
    "deny": [
      "Read(./**/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.jks)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/credentials.json)",
      "Read(./**/service-account*.json)",
      "Read(./**/key.properties)",
      "Read(./**/secret*.json)",
      "Read(./**/secret*.y*ml)",
      "Read(./**/secret*.txt)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.ssh/id_*)",
      "Edit(./**/*.g.dart)",
      "Write(./**/*.g.dart)",
      "Edit(./**/*.freezed.dart)",
      "Write(./**/*.freezed.dart)",
      "Edit(./**/*.config.dart)",
      "Write(./**/*.config.dart)"
    ]
  }
}
