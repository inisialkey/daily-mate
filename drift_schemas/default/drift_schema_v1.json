  "fixed_sql": [
    {
      "name": "notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL DEFAULT '', \"body\" TEXT NOT NULL DEFAULT '', \"folder\" TEXT NULL, \"is_pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pinned\" IN (0, 1)), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"due_date\" TEXT NULL, \"due_minutes\" INTEGER NULL, \"priority\" INTEGER NOT NULL DEFAULT 0, \"category\" TEXT NULL, \"recurrence_frequency\" TEXT NULL, \"recurrence_interval\" INTEGER NOT NULL DEFAULT 1, \"recurrence_weekdays\" INTEGER NOT NULL DEFAULT 0, \"recurrence_until\" TEXT NULL, \"recurrence_anchor\" TEXT NULL, \"reminder_offset_minutes\" INTEGER NULL, \"reminder_snoozed_until\" INTEGER NULL, \"note_id\" INTEGER NULL REFERENCES notes (id) ON DELETE SET NULL, \"successor_id\" INTEGER NULL REFERENCES tasks (id) ON DELETE SET NULL, \"completed_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, CHECK (due_minutes BETWEEN 0 AND 1439), CHECK (recurrence_interval >= 1), CHECK (reminder_offset_minutes >= 0));"
        }
      ]
    },
    {
      "name": "subtasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subtasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"is_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_done\" IN (0, 1)), \"position\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE COLLATE NOCASE);"
        }
      ]
    },
    {
      "name": "task_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_tags\" (\"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"tag_id\" INTEGER NOT NULL REFERENCES tags (id) ON DELETE CASCADE, PRIMARY KEY (\"task_id\", \"tag_id\"));"
        }
      ]
    },
    {
      "name": "note_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"note_tags\" (\"note_id\" INTEGER NOT NULL REFERENCES notes (id) ON DELETE CASCADE, \"tag_id\" INTEGER NOT NULL REFERENCES tags (id) ON DELETE CASCADE, PRIMARY KEY (\"note_id\", \"tag_id\"));"
        }
      ]
    },
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"date\" TEXT NOT NULL, \"minutes\" INTEGER NOT NULL, \"recurrence_frequency\" TEXT NULL, \"recurrence_interval\" INTEGER NOT NULL DEFAULT 1, \"recurrence_weekdays\" INTEGER NOT NULL DEFAULT 0, \"recurrence_until\" TEXT NULL, \"is_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_enabled\" IN (0, 1)), \"snoozed_until\" INTEGER NULL, \"completed_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, CHECK (minutes BETWEEN 0 AND 1439), CHECK (recurrence_interval >= 1));"
        }
      ]
    },
    {
      "name": "reminder_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminder_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"reminder_id\" INTEGER NULL REFERENCES reminders (id) ON DELETE SET NULL, \"task_id\" INTEGER NULL REFERENCES tasks (id) ON DELETE SET NULL, \"title\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"occurred_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "prayer_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"prayer_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"location_name\" TEXT NULL, \"method\" TEXT NOT NULL DEFAULT 'kemenag', \"asr_method\" TEXT NOT NULL DEFAULT 'standard', \"high_latitude_mode\" TEXT NOT NULL DEFAULT 'middleOfTheNight', PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "prayer_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"prayer_preferences\" (\"prayer\" TEXT NOT NULL, \"adjustment_minutes\" INTEGER NOT NULL DEFAULT 0, \"notify\" INTEGER NOT NULL DEFAULT 1 CHECK (\"notify\" IN (0, 1)), \"advance_minutes\" INTEGER NOT NULL DEFAULT 0, \"sound\" INTEGER NOT NULL DEFAULT 1 CHECK (\"sound\" IN (0, 1)), PRIMARY KEY (\"prayer\"), CHECK (adjustment_minutes BETWEEN -60 AND 60), CHECK (advance_minutes BETWEEN 0 AND 120));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"sidebar_collapsed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"sidebar_collapsed\" IN (0, 1)), \"default_reminder_minutes\" INTEGER NOT NULL DEFAULT 540, \"welcome_dismissed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"welcome_dismissed\" IN (0, 1)), \"notifications_checked_at\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (default_reminder_minutes BETWEEN 0 AND 1439));"
        }
